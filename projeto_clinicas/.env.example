# Copie este arquivo para ".env" e preencha com valores reais.
# NUNCA cometa o arquivo ".env" no controle de versao.

# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=troque-esta-chave-por-uma-string-aleatoria-longa
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Banco de dados (PostgreSQL). Deixe vazio para usar SQLite em desenvolvimento.
DATABASE_URL=postgres://jja_user:jja_password@localhost:5432/jja_system

# Redis / Celery
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
CELERY_TASK_ALWAYS_EAGER=True

# E-mail
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=nao-responda@jjasystem.com.br

# Armazenamento
MEDIA_ROOT=media
PRIVATE_MEDIA_ROOT=private_media
MAX_UPLOAD_SIZE_MB=25
BACKUP_ROOT=backups
BACKUP_RETENTION_DAYS=30

# Sessao / seguranca
SESSION_COOKIE_AGE=1800
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# Plataforma
PLATFORM_NAME=Alume Tech
PLATFORM_PRIMARY_COLOR=#0b5ed7
PLATFORM_SUPPORT_EMAIL=suporte@jjasystem.com.br

# Monitoramento (opcional)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Producao (config.settings.prod)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
